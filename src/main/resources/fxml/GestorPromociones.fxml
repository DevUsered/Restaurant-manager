<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="rootPane" prefHeight="650.0" prefWidth="1050.0" style="-fx-background-color: transparent;" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Attizos.Frontend.GestorPromocionesController">
    <children>
        <AnchorPane style="-fx-background-color: #FFFFFF; -fx-background-radius: 15; -fx-border-color: #DAA520; -fx-border-width: 2; -fx-border-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 20, 0, 0, 5);" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="50.0" style="-fx-background-color: #FDF6E3; -fx-background-radius: 13 13 0 0; -fx-padding: 0 15;" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                    <children>
                        <Label text="🎁 Gestor de Promociones y Combos" textFill="#111111">
                            <font><Font name="System Bold" size="20.0" /></font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#cerrarVentana" style="-fx-background-color: transparent; -fx-text-fill: #ff4c4c; -fx-font-size: 18px; -fx-font-weight: bold; -fx-cursor: hand;" text="✕" />
                    </children>
                </HBox>

                <HBox spacing="20.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="60.0">
                    <children>
                        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Promociones Registradas" textFill="#555555">
                                    <font><Font name="System Bold" size="14.0" /></font>
                                </Label>
                                <TableView fx:id="tablaPromos" prefHeight="450.0" styleClass="modern-table" style="-fx-background-color: #FFFFFF; -fx-border-color: #DDDDDD; -fx-border-radius: 5;" VBox.vgrow="ALWAYS">
                                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                                    <columns>
                                        <TableColumn fx:id="colId" prefWidth="40.0" text="ID" />
                                        <TableColumn fx:id="colNombrePromo" prefWidth="150.0" text="NOMBRE COMBO" />
                                        <TableColumn fx:id="colPrecio" prefWidth="80.0" text="PRECIO Bs" />
                                        <TableColumn fx:id="colInicio" prefWidth="90.0" text="INICIO" />
                                        <TableColumn fx:id="colFin" prefWidth="90.0" text="FIN" />
                                        <TableColumn fx:id="colEstado" prefWidth="80.0" text="ESTADO" />
                                    </columns>
                                </TableView>
                                <HBox spacing="10.0">
                                    <children>
                                        <Button maxWidth="Infinity" onAction="#cargarParaEditar" prefHeight="35.0" style="-fx-background-color: rgba(33, 140, 78, 0.1); -fx-border-color: #218c4e; -fx-border-radius: 8; -fx-text-fill: #218c4e; -fx-font-weight: bold; -fx-cursor: hand;" text="✏ Editar Promo" HBox.hgrow="ALWAYS" />
                                        <Button maxWidth="Infinity" onAction="#terminarPromocion" prefHeight="35.0" style="-fx-background-color: rgba(243, 156, 18, 0.1); -fx-border-color: #f39c12; -fx-border-radius: 8; -fx-text-fill: #f39c12; -fx-font-weight: bold; -fx-cursor: hand;" text="🛑 Pausar/Terminar" HBox.hgrow="ALWAYS" />
                                        <Button maxWidth="Infinity" onAction="#eliminarPromocion" prefHeight="35.0" style="-fx-background-color: rgba(255, 76, 76, 0.1); -fx-border-color: #ff4c4c; -fx-border-radius: 8; -fx-text-fill: #ff4c4c; -fx-font-weight: bold; -fx-cursor: hand;" text="🗑 Eliminar" HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <VBox minWidth="380.0" prefWidth="380.0" spacing="10.0" style="-fx-background-color: #FDF6E3; -fx-background-radius: 10; -fx-border-color: #DDDDDD; -fx-padding: 15; -fx-border-radius: 10;">
                            <children>
                                <Label fx:id="lblTituloFormulario" text="Crear Nuevo Combo" textFill="#111111">
                                    <font><Font name="System Bold" size="16.0" /></font>
                                </Label>

                                <TextField fx:id="txtNombre" promptText="Nombre de la promoción..." style="-fx-background-color: #FFFFFF; -fx-border-color: #DDDDDD; -fx-border-radius: 5; -fx-padding: 8; -fx-text-fill: #111111; -fx-prompt-text-fill: #999999;" />
                                <TextField fx:id="txtPrecio" promptText="Precio en Oferta (Bs)..." style="-fx-background-color: #FFFFFF; -fx-border-color: #DDDDDD; -fx-border-radius: 5; -fx-padding: 8; -fx-text-fill: #111111; -fx-prompt-text-fill: #999999;" />

                                <HBox spacing="10.0">
                                    <children>
                                        <VBox HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="Fecha Inicio:" textFill="#555555" />
                                                <DatePicker fx:id="dpInicio" maxWidth="Infinity" style="-fx-background-color: #FFFFFF; -fx-control-inner-background: #FFFFFF; -fx-border-color: #DDDDDD; -fx-border-radius: 5; -fx-text-fill: #111111;" />
                                            </children>
                                        </VBox>
                                        <VBox HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="Fecha Fin (Opcional):" textFill="#555555" />
                                                <DatePicker fx:id="dpFin" maxWidth="Infinity" style="-fx-background-color: #FFFFFF; -fx-control-inner-background: #FFFFFF; -fx-border-color: #DDDDDD; -fx-border-radius: 5; -fx-text-fill: #111111;" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <HBox alignment="CENTER_LEFT" spacing="15.0">
                                    <children>
                                        <ImageView fx:id="imgPreview" fitHeight="50.0" fitWidth="50.0" style="-fx-background-color: #FFFFFF; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 1);" />
                                        <Button onAction="#seleccionarImagen" style="-fx-background-color: #FFFFFF; -fx-border-color: #555555; -fx-border-radius: 5; -fx-text-fill: #111111; -fx-cursor: hand;" text="🖼 Subir Portada" />
                                    </children>
                                </HBox>

                                <AnchorPane prefHeight="1.0" style="-fx-background-color: #DDDDDD;">
                                    <VBox.margin><Insets bottom="5.0" top="5.0" /></VBox.margin>
                                </AnchorPane>

                                <Label text="¿Qué incluye este Combo?" textFill="#111111">
                                    <font><Font name="System Bold" size="13.0" /></font>
                                </Label>

                                <HBox spacing="5.0">
                                    <children>
                                        <ComboBox fx:id="cmbProductosMenu" editable="true" maxWidth="Infinity" promptText="🔍 Buscar producto..." style="-fx-background-color: #FFFFFF; -fx-border-color: #DDDDDD; -fx-border-radius: 5; -fx-base: #FFFFFF;" HBox.hgrow="ALWAYS" />
                                        <TextField fx:id="txtCantidad" prefWidth="70.0" promptText="Cant." style="-fx-background-color: #FFFFFF; -fx-border-color: #DDDDDD; -fx-border-radius: 5; -fx-padding: 8; -fx-text-fill: #111111; -fx-prompt-text-fill: #999999; -fx-font-weight: bold;" />
                                        <Button fx:id="btnAgregarAlCombo" onAction="#agregarAlCombo" style="-fx-background-color: rgba(218, 165, 32, 0.2); -fx-border-color: #DAA520; -fx-border-radius: 5; -fx-text-fill: #DAA520; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 12;" text="➕" />
                                    </children>
                                </HBox>

                                <TableView fx:id="tablaContenido" prefHeight="120.0" styleClass="modern-table" style="-fx-background-color: #FFFFFF; -fx-border-color: #DDDDDD; -fx-border-radius: 5;" VBox.vgrow="ALWAYS">
                                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                                    <columns>
                                        <TableColumn fx:id="colCProducto" prefWidth="200.0" text="PRODUCTO" />
                                        <TableColumn fx:id="colCCantidad" prefWidth="60.0" text="CANT." />
                                    </columns>
                                </TableView>

                                <HBox spacing="10.0">
                                    <children>
                                        <Button maxWidth="Infinity" onAction="#limpiarFormularioAction" prefHeight="40.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #555555; -fx-text-fill: #111111; -fx-background-radius: 8; -fx-border-radius: 8; -fx-font-weight: bold; -fx-cursor: hand;" text="Limpiar / Cancelar" HBox.hgrow="ALWAYS" />
                                        <Button maxWidth="Infinity" onAction="#guardarPromocion" prefHeight="40.0" style="-fx-background-color: linear-gradient(to right, #00ff88, #00cc6a); -fx-text-fill: #111111; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="💾 Guardar Combo" HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </AnchorPane>
    </children>
</AnchorPane>