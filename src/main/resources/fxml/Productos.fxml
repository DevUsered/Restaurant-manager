<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="1100.0" style="-fx-background-color: transparent;" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Attizos.Frontend.ProductosController">
    <children>
        <VBox spacing="15.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <children>
                        <Label text="🍕 GESTIÓN DE MENÚ Y RECETAS" textFill="#111111">
                            <font><Font name="System Bold" size="24.0" /></font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#abrirVentanaPromocion" prefHeight="40.0" style="-fx-background-color: linear-gradient(to right, #ff9966, #ff5e62); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor:                         hand; -fx-padding: 0 20; -fx-effect: dropshadow(gaussian, rgba(255, 94, 98, 0.4), 10, 0, 0, 3);" text="🎁 Promociones" />
                    </children>
                </HBox>

                <HBox spacing="20.0" VBox.vgrow="ALWAYS">
                    <children>
                        <VBox minWidth="500.0" spacing="10.0" HBox.hgrow="ALWAYS">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 8; -fx-padding: 10; -fx-border-color: #DDDDDD; -fx-border-radius: 8;">
                                    <children>
                                        <Label text="🔍 Buscar:" textFill="#555555">
                                            <font><Font name="System Bold" size="14.0" /></font>
                                        </Label>
                                        <TextField fx:id="txtBuscador" promptText="Escriba el nombre, categoría o ID..." style="-fx-background-color: #F5F5F5; -fx-text-fill: #111111; -fx-border-color: transparent;" HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>

                                <TableView fx:id="tablaMenu" styleClass="modern-table" VBox.vgrow="ALWAYS">
                                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                                    <columns>
                                        <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                                        <TableColumn fx:id="colNombre" prefWidth="180.0" text="PRODUCTO" />
                                        <TableColumn fx:id="colCategoria" prefWidth="100.0" text="CATEGORÍA" />
                                        <TableColumn fx:id="colPrecio" prefWidth="80.0" text="PRECIO Bs" />
                                        <TableColumn fx:id="colStock" prefWidth="80.0" text="STOCK" />
                                        <TableColumn fx:id="colTipo" prefWidth="120.0" text="TIPO" />
                                    </columns>
                                </TableView>

                                <VBox spacing="10.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 10; -fx-border-color: #DDDDDD; -fx-border-radius: 10; -fx-padding: 15;">
                                    <children>
                                        <Label text="⚡ Ajuste Rápido (Seleccione producto y elija acción):" textFill="#111111">
                                            <font><Font name="System Bold" size="13.0" /></font>
                                        </Label>
                                        <HBox spacing="10.0">
                                            <children>
                                                <Button maxWidth="Infinity" onAction="#sumarStockExistente" prefHeight="35.0" style="-fx-background-color: rgba(33, 140, 78, 0.1); -fx-border-color: #218c4e; -fx-border-radius: 8; -fx-text-fill: #218c4e; -fx-font-weight: bold; -fx-cursor: hand;" text="➕ Sumar Stock" HBox.hgrow="ALWAYS" />
                                                <Button maxWidth="Infinity" onAction="#restarStock" prefHeight="35.0" style="-fx-background-color: rgba(243, 156, 18, 0.1); -fx-border-color: #f39c12; -fx-border-radius: 8; -fx-text-fill: #f39c12; -fx-font-weight: bold; -fx-cursor: hand;" text="➖ Restar Stock" HBox.hgrow="ALWAYS" />
                                                <Button maxWidth="Infinity" onAction="#eliminarProducto" prefHeight="35.0" style="-fx-background-color: rgba(255, 76, 76, 0.1); -fx-border-color: #ff4c4c; -fx-border-radius: 8; -fx-text-fill: #ff4c4c; -fx-font-weight: bold; -fx-cursor: hand;" text="🗑 Dar de Baja" HBox.hgrow="ALWAYS" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                        <VBox minWidth="380.0" prefWidth="380.0" spacing="10.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 15; -fx-border-color: rgba(218, 165, 32, 0.3); -fx-border-width: 1.5; -fx-border-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 5);" HBox.hgrow="NEVER">
                            <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                            <children>
                                <Label text="Crear Nuevo Producto" textFill="#111111">
                                    <font><Font name="System Bold" size="18.0" /></font>
                                </Label>

                                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                                    <content>
                                        <VBox spacing="10.0" style="-fx-padding: 0 10 0 0;">
                                            <children>
                                                <Label text="Tipo de Clase:" textFill="#218c4e" />
                                                <ComboBox fx:id="cmbTipoClase" maxWidth="Infinity" promptText="Seleccione tipo..." style="-fx-base: #FFFFFF; -fx-background-color: #F5F5F5; -fx-border-color: #DDDDDD; -fx-border-radius: 5;" />

                                                <HBox alignment="CENTER_LEFT" spacing="15.0">
                                                    <children>
                                                        <ImageView fx:id="imgPreview" fitHeight="60.0" fitWidth="60.0" style="-fx-background-color: #F5F5F5;" />
                                                        <Button onAction="#seleccionarImagen" style="-fx-background-color: transparent; -fx-border-color: #555555; -fx-border-radius: 5; -fx-text-fill: #555555; -fx-cursor: hand;" text="🖼 Subir Imagen" />
                                                    </children>
                                                </HBox>

                                                <Label text="Nombre del Producto:" textFill="#555555" />
                                                <TextField fx:id="txtNombre" promptText="Nombre... (Presiona Enter)" style="-fx-background-color: #F5F5F5; -fx-text-fill: #111111; -fx-border-color: #DDDDDD; -fx-border-radius: 5;" />

                                                <Label text="Precio de Venta (Bs):" textFill="#555555" />
                                                <TextField fx:id="txtPrecio" promptText="0.00 (Presiona Enter)" style="-fx-background-color: #F5F5F5; -fx-text-fill: #111111; -fx-border-color: #DDDDDD; -fx-border-radius: 5;" />

                                                <VBox fx:id="vboxCategoria" spacing="5.0">
                                                    <children>
                                                        <Label text="Categoría Personalizada:" textFill="#555555" />
                                                        <ComboBox fx:id="cmbCategoria" editable="true" maxWidth="Infinity" promptText="Escriba la categoría..." />
                                                    </children>
                                                </VBox>

                                                <VBox fx:id="vboxStock" spacing="5.0">
                                                    <children>
                                                        <Label text="Stock Inicial en Vitrina:" textFill="#555555" />
                                                        <TextField fx:id="txtStock" promptText="Cantidad actual" style="-fx-background-color: #F5F5F5; -fx-text-fill: #111111; -fx-border-color: #DDDDDD; -fx-border-radius: 5;" />
                                                    </children>
                                                </VBox>

                                                <VBox fx:id="panelAtributosDinamicos" spacing="8.0" style="-fx-background-color: #FDF6E3; -fx-border-color: #DDDDDD; -fx-padding: 10; -fx-background-radius: 5; -fx-border-radius: 5;" />

                                                <VBox fx:id="vboxReceta" spacing="5.0">
                                                    <children>
                                                        <Label text="Receta e Ingredientes:" textFill="#111111" />
                                                        <TextField fx:id="txtBuscarInsumo" promptText="🔍 Buscar ingrediente..." style="-fx-background-color: #F5F5F5; -fx-text-fill: #111111; -fx-border-color: #DDDDDD; -fx-border-radius: 5;" />
                                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                            <children>
                                                                <ComboBox fx:id="cmbInsumos" maxWidth="Infinity" promptText="Insumo..." style="-fx-base: #FFFFFF; -fx-background-color: #F5F5F5; -fx-border-color: #DDDDDD; -fx-border-radius: 5;" HBox.hgrow="ALWAYS" />
                                                                <TextField fx:id="txtCantidadReceta" minWidth="80.0" prefWidth="80.0" promptText="Cant." style="-fx-background-color: #F5F5F5; -fx-text-fill: #111111; -fx-border-color: #DDDDDD; -fx-border-radius: 5;" />
                                                                <Button fx:id="btnAgregarIngrediente" minWidth="40.0" onAction="#agregarIngredienteVisual" style="-fx-background-color: rgba(218, 165, 32, 0.2); -fx-border-color: #DAA520; -fx-text-fill: #DAA520; -fx-font-weight: bold; -fx-cursor: hand;" text="➕" />
                                                            </children>
                                                        </HBox>

                                                        <TableView fx:id="tablaRecetaFila" prefHeight="120.0" styleClass="modern-table">
                                                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                                                            <columns>
                                                                <TableColumn fx:id="colRecetaInsumo" prefWidth="180.0" text="INGREDIENTE" />
                                                                <TableColumn fx:id="colRecetaCant" prefWidth="100.0" text="CANT" />
                                                            </columns>
                                                        </TableView>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </VBox>
                                    </content>
                                </ScrollPane>

                                <Button maxWidth="Infinity" minHeight="45.0" onAction="#guardarNuevoProducto" prefHeight="45.0" style="-fx-background-color: linear-gradient(to right, #00ff88, #00cc6a); -fx-text-fill: #111111; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;" text="💾 GUARDAR PRODUCTO FINAL">
                                    <VBox.margin>
                                        <Insets top="5.0" />
                                    </VBox.margin>
                                </Button>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
