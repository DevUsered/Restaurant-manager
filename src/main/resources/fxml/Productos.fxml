<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToHeight="true" fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Attizos.Frontend.ProductosController">
    <content>
        <AnchorPane style="-fx-background-color: #120524;">
            <children>
                <VBox spacing="15.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="20.0">
                            <children>
                                <Label text="🍕 GESTIÓN DE MENÚ Y RECETAS" textFill="WHITE">
                                    <font><Font name="System Bold" size="24.0" /></font>
                                </Label>
                            </children>
                        </HBox>

                        <HBox spacing="20.0" VBox.vgrow="ALWAYS">
                            <children>
                                <VBox minWidth="500.0" spacing="10.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: rgba(255,255,255,0.05); -fx-background-radius: 8; -fx-padding: 10;">
                                            <children>
                                                <Label text="🔍 Buscar:" textFill="#00d2ff">
                                                    <font><Font name="System Bold" size="14.0" /></font>
                                                </Label>
                                                <TextField fx:id="txtBuscador" promptText="Escriba el nombre, categoría o ID..." style="-fx-background-color: rgba(0,0,0,0.4); -fx-text-fill: white;" HBox.hgrow="ALWAYS" />
                                            </children>
                                        </HBox>

                                        <TableView fx:id="tablaMenu" minHeight="300.0" style="-fx-base: #1a0a2a; -fx-control-inner-background: #1a0a2a; -fx-background-color: #1a0a2a; -fx-background-radius: 10;" VBox.vgrow="ALWAYS">
                                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                                            <columns>
                                                <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                                                <TableColumn fx:id="colNombre" prefWidth="180.0" text="PRODUCTO" />
                                                <TableColumn fx:id="colCategoria" prefWidth="100.0" text="CATEGORÍA" />
                                                <TableColumn fx:id="colPrecio" prefWidth="80.0" text="PRECIO Bs" />
                                                <TableColumn fx:id="colStock" prefWidth="80.0" text="STOCK" />
                                                <TableColumn fx:id="colTipo" prefWidth="120.0" text="TIPO" />
                                            </columns>
                                        </TableView>

                                        <VBox spacing="10.0" style="-fx-background-color: rgba(255,255,255,0.05); -fx-background-radius: 10; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 10; -fx-padding: 15;">
                                            <children>
                                                <Label text="⚡ Ajuste Rápido (Seleccione producto y elija acción):" textFill="WHITE">
                                                    <font><Font name="System Bold" size="13.0" /></font>
                                                </Label>
                                                <HBox spacing="10.0">
                                                    <children>
                                                        <Button maxWidth="Infinity" onAction="#sumarStockExistente" prefHeight="35.0" style="-fx-background-color: rgba(0, 210, 255, 0.1); -fx-border-color: #00d2ff; -fx-border-radius: 8; -fx-text-fill: #00d2ff; -fx-font-weight: bold; -fx-cursor: hand;" text="➕ Sumar Stock" HBox.hgrow="ALWAYS" />
                                                        <Button maxWidth="Infinity" onAction="#restarStock" prefHeight="35.0" style="-fx-background-color: rgba(243, 156, 18, 0.1); -fx-border-color: #f39c12; -fx-border-radius: 8; -fx-text-fill: #f39c12; -fx-font-weight: bold; -fx-cursor: hand;" text="➖ Restar Stock" HBox.hgrow="ALWAYS" />
                                                        <Button maxWidth="Infinity" onAction="#eliminarProducto" prefHeight="35.0" style="-fx-background-color: rgba(255, 76, 76, 0.1); -fx-border-color: #ff4c4c; -fx-border-radius: 8; -fx-text-fill: #ff4c4c; -fx-font-weight: bold; -fx-cursor: hand;" text="🗑 Dar de Baja" HBox.hgrow="ALWAYS" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>

                                <VBox minWidth="380.0" prefWidth="380.0" spacing="10.0" style="-fx-background-color: rgba(255, 255, 255, 0.05); -fx-background-radius: 15; -fx-border-color: rgba(255, 255, 255, 0.1); -fx-border-radius: 15;">
                                    <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                                    <children>
                                        <Label text="Crear Nuevo Producto" textFill="WHITE">
                                            <font><Font name="System Bold" size="18.0" /></font>
                                        </Label>

                                        <Label text="Tipo de Clase:" textFill="#00ff88" />
                                        <ComboBox fx:id="cmbTipoClase" maxWidth="Infinity" promptText="Seleccione tipo..." style="-fx-base: #1a0a2a;" />

                                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                                            <children>
                                                <ImageView fx:id="imgPreview" fitHeight="60.0" fitWidth="60.0" style="-fx-background-color: rgba(0,0,0,0.5);" />
                                                <Button onAction="#seleccionarImagen" style="-fx-background-color: transparent; -fx-border-color: #b39ddb; -fx-border-radius: 5; -fx-text-fill: #b39ddb; -fx-cursor: hand;" text="🖼 Subir Imagen" />
                                            </children>
                                        </HBox>

                                        <Label text="Nombre del Producto:" textFill="#b39ddb" />
                                        <TextField fx:id="txtNombre" promptText="Nombre..." style="-fx-background-color: rgba(0,0,0,0.3); -fx-text-fill: white;" />

                                        <Label text="Precio de Venta (Bs):" textFill="#b39ddb" />
                                        <TextField fx:id="txtPrecio" promptText="0.00" style="-fx-background-color: rgba(0,0,0,0.3); -fx-text-fill: white;" />

                                        <VBox fx:id="vboxCategoria" spacing="5.0">
                                            <children>
                                                <Label text="Categoría Personalizada:" textFill="#b39ddb" />
                                                <ComboBox fx:id="cmbCategoria" editable="true" maxWidth="Infinity" promptText="Escriba la categoría..." style="-fx-base: #1a0a2a;" />
                                            </children>
                                        </VBox>

                                        <VBox fx:id="vboxStock" spacing="5.0">
                                            <children>
                                                <Label text="Stock Inicial en Vitrina:" textFill="#b39ddb" />
                                                <TextField fx:id="txtStock" promptText="Cantidad actual" style="-fx-background-color: rgba(0,0,0,0.3); -fx-text-fill: white;" />
                                            </children>
                                        </VBox>

                                        <VBox fx:id="panelAtributosDinamicos" spacing="8.0" style="-fx-background-color: rgba(0,0,0,0.2); -fx-padding: 10; -fx-background-radius: 5;" />

                                        <Label text="Receta (Solo para productos de cocina)" textFill="WHITE" />
                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                            <children>
                                                <ComboBox fx:id="cmbInsumos" maxWidth="Infinity" promptText="Insumo..." style="-fx-base: #1a0a2a;" HBox.hgrow="ALWAYS" />
                                                <TextField fx:id="txtCantidadReceta" minWidth="80.0" prefWidth="80.0" promptText="Cant." style="-fx-background-color: rgba(0,0,0,0.3); -fx-text-fill: white;" />
                                                <Button minWidth="40.0" onAction="#agregarIngredienteVisual" style="-fx-background-color: rgba(243, 156, 18, 0.2); -fx-border-color: #f39c12; -fx-text-fill: #f39c12; -fx-font-weight: bold; -fx-cursor: hand;" text="➕" />
                                            </children>
                                        </HBox>

                                        <TableView fx:id="tablaRecetaFila" prefHeight="100.0" style="-fx-base: #1a0a2a;">
                                            <columns>
                                                <TableColumn fx:id="colRecetaInsumo" prefWidth="180.0" text="INGREDIENTE" />
                                                <TableColumn fx:id="colRecetaCant" prefWidth="100.0" text="CANT" />
                                            </columns>
                                        </TableView>

                                        <Button maxWidth="Infinity" onAction="#guardarNuevoProducto" prefHeight="45.0" style="-fx-background-color: linear-gradient(to right, #00ff88, #00cc6a); -fx-text-fill: #120524; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;" text="💾 GUARDAR PRODUCTO FINAL">
                                            <VBox.margin>
                                                <Insets top="10.0" />
                                            </VBox.margin>
                                        </Button>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </AnchorPane>
    </content>
</ScrollPane>