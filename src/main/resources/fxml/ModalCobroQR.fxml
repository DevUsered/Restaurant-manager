<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="rootPane" prefHeight="450.0" prefWidth="350.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #DAA520; -fx-border-width: 3; -fx-background-radius: 15; -fx-border-radius: 15;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Attizos.Frontend.Cobros.CobroQRController">
    <children>
        <VBox alignment="CENTER" spacing="15.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
            <children>
                <Label text="Cobro con QR " textFill="#111111">
                    <font><Font name="System Bold" size="22.0" /></font>
                </Label>

                <Label fx:id="lblMonto" text="Bs. 0.00" textFill="#218c4e">
                    <font><Font name="System Bold" size="36.0" /></font>
                </Label>

                <StackPane prefHeight="220.0" prefWidth="220.0" style="-fx-background-color: #FDF6E3; -fx-border-color: #DDDDDD; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 10;">
                    <children>
                        <ImageView fx:id="imgQR" fitHeight="200.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" />
                    </children>
                </StackPane>

                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                        <ProgressIndicator fx:id="progressIndicador" prefHeight="25.0" prefWidth="25.0" />
                        <Label fx:id="lblEstado" text="Esperando pago..." textFill="#555555">
                            <font><Font name="System Bold" size="14.0" /></font>
                        </Label>
                    </children>
                </HBox>

                <HBox alignment="CENTER" spacing="15.0" style="-fx-padding: 10 0 0 0;">
                    <children>
                        <Button fx:id="btnCancelar" mnemonicParsing="false" onAction="#cancelarPago" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: transparent; -fx-border-color: #ff4c4c; -fx-text-fill: #ff4c4c; -fx-border-radius: 8; -fx-font-weight: bold; -fx-cursor: hand;" text="Cancelar" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
