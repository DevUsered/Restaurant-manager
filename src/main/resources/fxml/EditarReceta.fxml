<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="rootPane" prefHeight="520.0" prefWidth="580.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #DAA520; -fx-border-width: 3;" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Attizos.Frontend.EditarRecetaController">
   <children>
      <VBox spacing="12.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
         <children>
            <Label fx:id="lblTituloProducto" text="Receta de: [Producto]" textFill="#111111" wrapText="true">
               <font><Font name="System Bold" size="20.0" /></font>
            </Label>

            <VBox spacing="8.0" style="-fx-background-color: #FDF6E3; -fx-padding: 12; -fx-background-radius: 8; -fx-border-color: #E5D4A1; -fx-border-radius: 8;">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <ComboBox fx:id="cmbInsumos" editable="true" maxWidth="Infinity" prefWidth="240.0" promptText="🔍 Buscar o seleccione insumo..." style="-fx-background-color: #FFFFFF; -fx-border-color: #DDDDDD; -fx-border-radius: 5; -fx-font-size: 14px;" HBox.hgrow="ALWAYS" />
                        <TextField fx:id="txtCantidad" minWidth="105.0" prefWidth="115.0" promptText="Cant." style="-fx-background-color: #FFFFFF; -fx-border-color: #DDDDDD; -fx-border-radius: 5; -fx-font-size: 14px; -fx-text-fill: #444444; -fx-font-weight: bold;" />
                        <Button minWidth="80.0" mnemonicParsing="false" onAction="#agregarIngrediente" style="-fx-background-color: #218c4e; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-font-size: 14px; -fx-cursor: hand; -fx-padding: 6 14;" text="Añadir" />
                     </children>
                  </HBox>

                  <Label fx:id="lblUnidadInsumo" managed="false" maxWidth="Infinity" visible="false" wrapText="true" style="-fx-background-color: #FFF8E1; -fx-border-color: #DAA520; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 6 10; -fx-text-fill: #7A5C00; -fx-font-size: 12px; -fx-font-weight: bold;" />
               </children>
            </VBox>

            <Label text="* Clic derecho en la tabla para editar cantidad o eliminar ingredientes" textFill="#555555">
               <font><Font size="11.0" /></font>
            </Label>

            <TableView fx:id="tablaReceta" prefHeight="250.0" styleClass="modern-table" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colInsumo" prefWidth="350.0" text="INGREDIENTE" />
                  <TableColumn fx:id="colCantidad" prefWidth="170.0" text="CANTIDAD" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>

            <HBox alignment="CENTER_RIGHT" spacing="15.0">
               <children>
                  <Button fx:id="btnCancelar" mnemonicParsing="false" onAction="#cancelar" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: transparent; -fx-border-color: #ff4c4c; -fx-text-fill: #ff4c4c; -fx-border-radius: 8; -fx-font-weight: bold; -fx-cursor: hand;" text="Cancelar" />
                  <Button mnemonicParsing="false" onAction="#guardarCambios" prefHeight="40.0" prefWidth="150.0" style="-fx-background-color: #DAA520; -fx-text-fill: #111111; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="💾 Guardar Receta" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>